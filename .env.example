# Copia este archivo a .env y completa tus valores. NUNCA subas el .env real.

# Google AI Studio (Gemini)
GOOGLE_API_KEY=

# Chatwoot
CHATWOOT_BASE_URL=https://tu-chatwoot.example.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_ACCESS_TOKEN=

# LlamaCloud (RAG)
LLAMA_CLOUD_API_KEY=
LLAMA_CLOUD_INDEX_NAME=automations_docs_api_adk

# Supabase: URL base del proyecto (sin /rest/v1) y la Secret key (sb_secret_...)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=

# Logs detallados en desarrollo (1) o apagados (0)
DEBUG_LOGS=1
